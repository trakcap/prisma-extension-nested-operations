{
  "name": "@trakcap/prisma-extension-nested-operations",
  "version": "1.0.1",
  "description": "Utils for creating Prisma client extensions with nested operations",
  "author": "Olivier Wilkinson",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trakcap/prisma-extension-nested-operations.git"
  },
  "engines": {
    "node": "~24.18.0"
  },
  "packageManager": "yarn@4.17.1",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepare": "/bin/sh -c 'if type git >/dev/null 2>&1; then git config core.hooksPath .git-hooks; else true; fi'",
    "prisma:generate": "prisma generate && biome format --fix test/dmmf.ts",
    "node-test": "node --import tsx --test",
    "test:unit": "yarn prisma:generate && yarn node-test test/unit/*.test.ts",
    "test:e2e": " yarn prisma:generate && ./test/scripts/run-with-postgres.sh yarn node-test test/e2e/*.test.ts",
    "test": "yarn prisma:generate && ./test/scripts/run-with-postgres.sh yarn node-test test/unit/*.test.ts test/e2e/*.test.ts",
    "test:ci": "yarn prisma:generate && ./test/scripts/run-with-postgres.sh ci yarn node-test test/unit/*.test.ts test/e2e/*.test.ts",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "lint:ci": "biome ci --reporter=github",
    "typecheck": "tsc --noEmit && yarn prisma:generate && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@open-draft/deferred-promise": "^3.0.0",
    "@prisma/client": ">=7",
    "es-toolkit": "^1.49.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@faker-js/faker": "^10.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/generator-helper": "^7.8.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^24.13.3",
    "@vitest/expect": "^4.1.10",
    "@vitest/spy": "^4.1.10",
    "chai": "^6.2.2",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
